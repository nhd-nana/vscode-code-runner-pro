{
  "name": "code-runner-pro",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.13.0",
  "featureFlags": {
    "usingNewPythonInterpreterPathApi": true,
    "usingNewPythonInterpreterPathApiV2": true
  },
  "publisher": "gy903",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "javascript",
    "php",
    "python",
    "perl",
    "ruby",
    "multi-root ready"
  ],
  "bugs": {
    "url": "https://github.com/nhd-nana/vscode-code-runner-pro/issues"
  },
  "homepage": "https://github.com/nhd-nana/vscode-code-runner-pro#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhd-nana/vscode-code-runner-pro.git"
  },
  "activationEvents": [
    "onCommand:crun.run",
    "onCommand:crun.runCustomCommand",
    "onCommand:crun.runByLanguage",
    "onStartupFinished"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "commands": [
      {
        "command": "crun.run",
        "title": "%command.run%",
        "icon": "$(play)"
      },
      {
        "command": "crun.runCustomCommand",
        "title": "%command.runCustomCommand%"
      },
      {
        "command": "crun.runByLanguage",
        "title": "%command.runByLanguage%"
      },
      {
        "command": "crun.stop",
        "title": "%command.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "crun.explain",
        "title": "%command.explain%"
      },
      {
        "command": "crun.showLanguageMap",
        "title": "%command.showLanguageMap%"
      }
    ],
    "keybindings": [
      {
        "command": "crun.run",
        "key": "ctrl+alt+n"
      },
      {
        "command": "crun.runCustomCommand",
        "key": "ctrl+alt+k"
      },
      {
        "command": "crun.runByLanguage",
        "key": "ctrl+alt+j"
      },
      {
        "command": "crun.stop",
        "key": "ctrl+alt+m"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "!inOutput && config.code-runner.showRunCommandInEditorContextMenu",
          "command": "crun.run",
          "group": "navigation"
        },
        {
          "when": "inOutput && !config.code-runner.runInTerminal",
          "command": "crun.stop",
          "group": "stop-code-run"
        }
      ],
      "editor/title/run": [
        {
          "when": "config.code-runner.showRunIconInEditorTitleMenu",
          "command": "crun.run",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "config.code-runner.showStopIconInEditorTitleMenu && crun.codeRunning",
          "command": "crun.stop",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "!explorerResourceIsFolder && config.code-runner.showRunCommandInExplorerContextMenu",
          "command": "crun.run",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "code-runner.executorMapByGlob": {
          "type": "object",
          "default": {
            "pom.xml": "cd $dir && mvn clean package"
          },
          "scope": "resource",
          "description": "%config.executorMapByGlob%"
        },
        "code-runner.executorMap": {
          "type": "object",
          "default": {
            "javascript": "node",
            "java": "cd $dir && javac $fileName && java $fileNameWithoutExt",
            "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "zig": "zig run",
            "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "objective-c": "cd $dir && gcc -framework Cocoa $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "php": "php",
            "python": "python -u",
            "perl": "perl",
            "perl6": "perl6",
            "ruby": "ruby",
            "go": "go run",
            "lua": "lua",
            "groovy": "groovy",
            "powershell": "powershell -ExecutionPolicy ByPass -File",
            "bat": "cmd /c",
            "shellscript": "bash",
            "fsharp": "fsi",
            "csharp": "scriptcs",
            "vbscript": "cscript //Nologo",
            "typescript": "ts-node",
            "coffeescript": "coffee",
            "scala": "scala",
            "swift": "swift",
            "julia": "julia",
            "crystal": "crystal",
            "ocaml": "ocaml",
            "r": "Rscript",
            "applescript": "osascript",
            "clojure": "lein exec",
            "haxe": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
            "rust": "cd $dir && rustc $fileName && $dir$fileNameWithoutExt",
            "racket": "racket",
            "scheme": "csi -script",
            "ahk": "autohotkey",
            "autoit": "autoit3",
            "dart": "dart",
            "pascal": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
            "d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
            "haskell": "runghc",
            "nim": "nim compile --verbosity:0 --hints:off --run",
            "lisp": "sbcl --script",
            "kit": "kitc --run",
            "v": "v run",
            "sass": "sass --style expanded",
            "scss": "scss --style expanded",
            "less": "cd $dir && lessc $fileName $fileNameWithoutExt.css",
            "FortranFreeForm": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "fortran-modern": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "fortran_fixed-form": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "fortran": "cd $dir && gfortran $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            "sml": "cd $dir && sml $fileName",
            "mojo": "mojo run",
            "erlang": "escript",
            "spwn": "spwn build",
            "pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
            "gleam": "gleam run -m $fileNameWithoutExt"
          },
          "scope": "resource",
          "description": "%config.executorMap%"
        },
        "code-runner.executorMapByFileExtension": {
          "type": "object",
          "default": {
            ".vb": "cd $dir && vbc /nologo $fileName && $dir$fileNameWithoutExt",
            ".vbs": "cscript //Nologo",
            ".scala": "scala",
            ".jl": "julia",
            ".cr": "crystal",
            ".ml": "ocaml",
            ".zig": "zig run",
            ".exs": "elixir",
            ".hx": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
            ".rkt": "racket",
            ".scm": "csi -script",
            ".ahk": "autohotkey",
            ".au3": "autoit3",
            ".kt": "cd $dir && kotlinc $fileName -include-runtime -d $fileNameWithoutExt.jar && java -jar $fileNameWithoutExt.jar",
            ".kts": "kotlinc -script",
            ".dart": "dart",
            ".pas": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
            ".pp": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
            ".d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
            ".hs": "runhaskell",
            ".nim": "nim compile --verbosity:0 --hints:off --run",
            ".csproj": "dotnet run --project",
            ".fsproj": "dotnet run --project",
            ".lisp": "sbcl --script",
            ".kit": "kitc --run",
            ".v": "v run",
            ".vsh": "v run",
            ".sass": "sass --style expanded",
            ".cu": "cd $dir && nvcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
            ".ring": "ring",
            ".sml": "cd $dir && sml $fileName",
            ".mojo": "mojo run",
            ".erl": "escript",
            ".spwn": "spwn build",
            ".pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
            ".gleam": "gleam run -m $fileNameWithoutExt"
          },
          "scope": "resource",
          "description": "%config.executorMapByFileExtension%"
        },
        "code-runner.customCommand": {
          "type": "string",
          "default": "echo Hello",
          "description": "%config.customCommand%",
          "scope": "resource"
        },
        "code-runner.matchOrder": {
          "type": "string",
          "default": "shebang, glob, extension, language, default",
          "description": "%config.matchOrder%",
          "scope": "resource"
        },
        "code-runner.defaultLanguage": {
          "type": "string",
          "default": "",
          "description": "%config.defaultLanguage%",
          "scope": "resource"
        },
        "code-runner.cwd": {
          "type": "string",
          "default": "",
          "description": "%config.cwd%",
          "scope": "resource"
        },
        "code-runner.fileDirectoryAsCwd": {
          "type": "boolean",
          "default": false,
          "description": "%config.fileDirectoryAsCwd%",
          "scope": "resource"
        },
        "code-runner.clearPreviousOutput": {
          "type": "boolean",
          "default": false,
          "description": "%config.clearPreviousOutput%",
          "scope": "resource"
        },
        "code-runner.saveAllFilesBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "%config.saveAllFilesBeforeRun%",
          "scope": "resource"
        },
        "code-runner.saveFileBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "%config.saveFileBeforeRun%",
          "scope": "resource"
        },
        "code-runner.showExecutionMessage": {
          "type": "boolean",
          "default": true,
          "description": "%config.showExecutionMessage%",
          "scope": "resource"
        },
        "code-runner.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "%config.runInTerminal%",
          "scope": "resource"
        },
        "code-runner.terminalRoot": {
          "type": "string",
          "default": "",
          "description": "%config.terminalRoot%",
          "scope": "resource"
        },
        "code-runner.preserveFocus": {
          "type": "boolean",
          "default": true,
          "description": "%config.preserveFocus%",
          "scope": "resource"
        },
        "code-runner.ignoreSelection": {
          "type": "boolean",
          "default": false,
          "description": "%config.ignoreSelection%",
          "scope": "resource"
        },
        "code-runner.showRunIconInEditorTitleMenu": {
          "type": "boolean",
          "default": true,
          "description": "%config.showRunIconInEditorTitleMenu%",
          "scope": "resource"
        },
        "code-runner.showStopIconInEditorTitleMenu": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStopIconInEditorTitleMenu%",
          "scope": "resource"
        },
        "code-runner.showRunCommandInEditorContextMenu": {
          "type": "boolean",
          "default": true,
          "description": "%config.showRunCommandInEditorContextMenu%",
          "scope": "resource"
        },
        "code-runner.showRunCommandInExplorerContextMenu": {
          "type": "boolean",
          "default": true,
          "description": "%config.showRunCommandInExplorerContextMenu%",
          "scope": "resource"
        },
        "code-runner.temporaryFileName": {
          "type": "string",
          "default": "tempCodeRunnerFile",
          "description": "%config.temporaryFileName%",
          "scope": "resource"
        },
        "code-runner.respectShebang": {
          "type": "boolean",
          "default": true,
          "description": "%config.respectShebang%",
          "scope": "resource"
        },
        "code-runner.multiActionBehavior": {
          "type": "string",
          "enum": [
            "pick",
            "last",
            "first"
          ],
          "default": "pick",
          "scope": "resource",
          "description": "%config.multiActionBehavior%"
        },
        "code-runner.showTempCode": {
          "type": "boolean",
          "default": false,
          "description": "%config.showTempCode%",
          "scope": "resource"
        },
        "code-runner.deleteTempFileAfterRun": {
          "type": "boolean",
          "default": true,
          "description": "%config.deleteTempFileAfterRun%",
          "scope": "resource"
        },
        "code-runner.multiSelectionMode": {
          "type": "string",
          "enum": [
            "concat",
            "primary"
          ],
          "default": "concat",
          "scope": "resource",
          "description": "%config.multiSelectionMode%"
        }
      }
    },
    "languages": [
      {
        "id": "code-runner-output",
        "mimetypes": [
          "text/x-code-output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "code-runner-output",
        "scopeName": "crun.output",
        "path": "./syntaxes/code-runner-output.tmLanguage"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "build": "tsc -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "micromatch": "^4.0.2",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.67.0",
    "typescript": "^5.4.3"
  }
}